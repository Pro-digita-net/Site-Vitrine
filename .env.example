# Site vitrine ProDigital — variables d'environnement
#
# Le service `site` (Nginx) n'a besoin d'aucune variable.
# Le service `api` (formulaire de contact) a besoin de celles ci-dessous.
# Dans Coolify, les définir dans l'onglet « Environment Variables » ; ne jamais
# les committer. Aucune n'est exposée au navigateur.

# Versions des images de base (arguments de build).
NODE_VERSION=22
NGINX_VERSION=1.28

# --- API : base de données (obligatoire) --------------------------------------
# Rôle dédié `site_vitrine`, limité au schéma `site` (server/sql/site-role-grants.sql).
DATABASE_URL=postgresql://site_vitrine:CHANGER@HOTE:5432/prodigital
# DATABASE_SSL=require

# --- API : Genesis CRM --------------------------------------------------------
# POST ${GENESIS_URL}/api/sales/public/leads, authentifié par le jeton de service
# (le même que la variable GENESIS_SERVICE_TOKEN du service Genesis).
GENESIS_URL=https://genesis.pro-digital.net
GENESIS_SERVICE_TOKEN=

# --- API : notification e-mail ------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# ssl (465) ou starttls (587)
SMTP_SECURITY=ssl
SMTP_USER=contact@pro-digital.net
SMTP_PASSWORD=
SMTP_FROM=contact@pro-digital.net
CONTACT_NOTIFY_TO=contact@pro-digital.net

# --- API : divers -------------------------------------------------------------
ALLOWED_ORIGINS=https://pro-digital.net,https://www.pro-digital.net
PUBLIC_SITE_URL=https://pro-digital.net

# Test local uniquement (docker-compose.local.yml) : port exposé sur 127.0.0.1.
LOCAL_PORT=8080
