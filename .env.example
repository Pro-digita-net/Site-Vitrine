# ProDigital — site vitrine / API de contact — configuration Coolify
# Modèle à compléter avant déploiement. Ne pas publier dans Git.
# Importer ces variables dans la ressource du SITE VITRINE, pas dans PostgreSQL.
#
# Le service `site` (Nginx) n'a besoin d'aucune variable.
# Le service `api` (formulaire de contact) a besoin de celles ci-dessous.
# Dans Coolify : onglet « Environment Variables ». Aucune n'est exposée au navigateur.

NODE_VERSION=22
NGINX_VERSION=1.28

# BASE POSTGRESQL
# Copier l'hôte et le port depuis « Internal URL » dans Coolify.
# Préférer un rôle applicatif `site_vitrine` (server/sql/site-role-grants.sql).
# Encoder les caractères spéciaux du mot de passe dans cette URL.
DATABASE_URL=postgresql://site_vitrine:CHANGER@HOTE:5432/prodigital
# Renseigner require uniquement si la connexion PostgreSQL utilise SSL.
DATABASE_SSL=

# GENESIS CRM — même jeton de service que dans Genesis.
GENESIS_URL=https://genesis.pro-digital.net
GENESIS_SERVICE_TOKEN=

# MESSAGERIE — fournisseur à confirmer.
# SMTP avec TLS implicite sur 465, ou STARTTLS : SMTP_PORT=587 et SMTP_SECURITY=starttls.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=contact@pro-digital.net
SMTP_PASSWORD=
SMTP_FROM=contact@pro-digital.net
CONTACT_NOTIFY_TO=contact@pro-digital.net

ALLOWED_ORIGINS=https://pro-digital.net,https://www.pro-digital.net
PUBLIC_SITE_URL=https://pro-digital.net

# Test local uniquement (docker-compose.local.yml) : port exposé sur 127.0.0.1.
LOCAL_PORT=8080

# PREREQUIS
# 1. Relier le service api et PostgreSQL via un réseau Docker accessible.
# 2. Créer le rôle site_vitrine avec son mot de passe et autoriser sa connexion.
# 3. Appliquer server/migrations/001-site-contact.sql à la base cible
#    avec le compte propriétaire, puis server/sql/site-role-grants.sql.
# 4. Compléter SMTP et le jeton Genesis dans Coolify puis redéployer.
# Le succès du formulaire confirme l'enregistrement en base, pas la livraison SMTP.
