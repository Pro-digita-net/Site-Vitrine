# Site vitrine ProDigital — variables d'environnement
#
# Le site est 100 % statique : aucune variable n'est obligatoire et aucun
# secret n'est nécessaire. Toutes les valeurs ci-dessous sont optionnelles.
# Dans Coolify, les définir dans l'onglet « Environment Variables ».

# Versions des images de base (arguments de build).
NODE_VERSION=22
NGINX_VERSION=1.28

# Test local uniquement (docker-compose.local.yml) : port exposé sur 127.0.0.1.
LOCAL_PORT=8080
