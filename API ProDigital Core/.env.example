# ProDigital Core API — variables d'environnement (à saisir dans Coolify, jamais dans le dépôt).
# Aucun secret ici : chaque mot de passe est défini par l'administrateur PostgreSQL (voir README, « Installation »).
# Encoder les caractères réservés des mots de passe dans les URL (%40 pour @, etc.).

# ── PostgreSQL : un compte par processus, jamais l'administrateur ──
CORE_DATABASE_URL=postgresql://pd_core_api:MOT_DE_PASSE@HOTE_POSTGRES_INTERNE:5432/prodigital
IAM_DATABASE_URL=postgresql://pd_iam_admin:MOT_DE_PASSE@HOTE_POSTGRES_INTERNE:5432/prodigital
WORKER_DATABASE_URL=postgresql://pd_core_worker:MOT_DE_PASSE@HOTE_POSTGRES_INTERNE:5432/prodigital
# Facultatif : lecture/relance des demandes du site depuis l'API Core (compte du site). Vide = routes /site en 503.
SITE_DATABASE_URL=
# "require" si PostgreSQL impose TLS avec un certificat vérifiable ; vide sur le réseau Docker privé.
DATABASE_SSL=
DATABASE_POOL_MAX=10
# Réseau Docker de la ressource PostgreSQL dans Coolify.
DATABASE_NETWORK=coolify

# ── Fournisseur d'identité OpenID Connect (connexion des utilisateurs) ──
# Sans ces valeurs, la connexion et l'acceptation d'invitation répondent 503 ; les clés API fonctionnent.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Facultatif : sinon découverte via <OIDC_ISSUER>/.well-known/openid-configuration
OIDC_JWKS_URI=
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72
API_KEY_MAX_DAYS=365

# ── Limites et exploitation ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
# Jeton long et aléatoire pour GET /metrics (vide = métriques désactivées).
METRICS_TOKEN=

# ── Worker : notifications e-mail et webhooks ──
SMTP_HOST=
SMTP_PORT=465
# ssl (465) | starttls (587)
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dossier du serveur contenant un fichier JSON par référence de secret de connexion.
SECRETS_HOST_DIR=./secrets
WORKER_POLL_MS=5000
WORKER_BACKOFF_SECONDS=30,120,600,1800,3600,10800

# ── Migrations (commande manuelle uniquement, jamais dans les services) ──
# MIGRATION_DATABASE_URL=postgresql://ADMINISTRATEUR:MOT_DE_PASSE@HOTE:5432/prodigital
